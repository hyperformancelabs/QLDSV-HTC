# =============================================
# QLDSV-HTC Project Configuration Template
# =============================================

# Project Metadata
PROJECT_NAME=QLDSV-HTC
PROJECT_VERSION=1.0.0
ENVIRONMENT=development

# =============================================
# Database Configuration (SHARED)
# =============================================

# Connection Settings
DB_HOST=localhost
DB_PORT=1434
DB_NAME=QLDSV_HTC
DB_DRIVER="ODBC Driver 18 for SQL Server"

# SQL Server Admin
MSSQL_SA_PASSWORD=QLDSV@2024!Strong

# Application Users (theo yêu cầu đề bài)
MSSQL_APP_USER=qldsv_app
MSSQL_APP_PASSWORD=App@2024!

# PGV - Phòng Giáo Vụ (toàn quyền)
MSSQL_PGV_USER=pgv_user
MSSQL_PGV_PASSWORD=PGV@2024!

# KHOA - Khoa (quyền hạn chế)
MSSQL_KHOA_USER=khoa_user
MSSQL_KHOA_PASSWORD=Khoa@2024!

# SV - Sinh Viên (login chung, password mặc định theo đề bài)
MSSQL_SV_USER=sv
MSSQL_SV_PASSWORD=SinhVien@2024

# =============================================
# Application Services (SHARED)
# =============================================

# Backend API
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_API_URL=http://localhost:8000

# Frontend
FRONTEND_HOST=localhost
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# =============================================
# Security Configuration
# =============================================

# JWT Settings
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# =============================================
# Docker Configuration
# =============================================

# Container Names
DB_CONTAINER_NAME=qldsv-sqlserver
BACKEND_CONTAINER_NAME=qldsv-backend
FRONTEND_CONTAINER_NAME=qldsv-frontend

# Docker Settings
DOCKER_NETWORK=qldsv-network
PLATFORM=linux/amd64
MSSQL_PID=Developer

# Volume Paths
DATA_VOLUME_PATH=./data
BACKUP_VOLUME_PATH=./database/backups
LOGS_VOLUME_PATH=./logs

# =============================================
# Development Settings
# =============================================

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Database Pool Settings
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_RECYCLE=3600

# Backup Settings
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"

# Health Check Settings
HEALTH_CHECK_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=5s
HEALTH_CHECK_RETRIES=5 