### Service with Stored Procedure
```python
async def get_by_lop(db: Session, ma_lop: str) -> List[schemas.SinhVien]:
    """Lấy danh sách sinh viên theo lớp"""
    try:
        result = await db.execute(
            text("EXEC SP_SinhVien_DanhSach @MaLop = :ma_lop"),
            {"ma_lop": ma_lop}
        )
        return [dict(row) for row in result]
    except SQLAlchemyError as e:
        logger.error(f"Database error: {str(e)}")
        raise HTTPException(status_code=500, detail="Database error")
```

### Database Connection with ODBC
```python
import pyodbc
from sqlalchemy import create_engine
from sqlalchemy.ext.declarative import declarative_base
from sqlalchemy.orm import sessionmaker

from app.core.config import get_settings

settings = get_settings()

# Check for ODBC drivers
def get_available_drivers():
    return pyodbc.drivers()

def get_connection_string():
    """Get the correct connection string based on available drivers"""
    drivers = get_available_drivers()
    
    # Prefer ODBC Driver 18 if available
    if "ODBC Driver 18 for SQL Server" in drivers:
        driver = "ODBC Driver 18 for SQL Server"
    elif "ODBC Driver 17 for SQL Server" in drivers:
        driver = "ODBC Driver 17 for SQL Server"
    else:
        # Fallback - let pyodbc try to find a suitable driver
        driver = "SQL Server"
        
    conn_str = f"DRIVER={{{driver}}};SERVER={settings.DB_HOST};DATABASE={settings.DB_NAME};UID={settings.MSSQL_APP_USER};PWD={settings.MSSQL_APP_PASSWORD};TrustServerCertificate=yes;"
    return conn_str

# Create engine
engine = create_engine(
    settings.DATABASE_URL,
    echo=settings.FASTAPI_DEBUG,
    connect_args={"check_same_thread": False}
)

# Create session factory
SessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)

# Create base class for models
Base = declarative_base()

# Dependency for database session
def get_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()
```

### Role-based Permissions
```python
def get_current_user_with_permissions(required_permissions: List[str]):
    def current_user_with_permissions(
        current_user: models.User = Depends(get_current_active_user),
    ) -> models.User:
        user_permissions = get_permissions_for_role(current_user.role)
        for permission in required_permissions:
            if permission not in user_permissions:
                raise HTTPException(
                    status_code=403,
                    detail="Không có quyền thực hiện chức năng này"
                )
        return current_user
    return current_user_with_permissions
```

## 🛡️ Error Handling Patterns
```python
try:
    # Business logic
except ValidationError as e:
    logger.warning(f"Validation error: {str(e)}")
    raise HTTPException(status_code=422, detail=str(e))
except PermissionError:
    logger.warning(f"Permission denied for user {current_user.username}")
    raise HTTPException(status_code=403, detail="Không có quyền")
except ResourceNotFoundError:
    raise HTTPException(status_code=404, detail="Không tìm thấy tài nguyên")
except pyodbc.Error as e:
    error_message = str(e)
    if "[unixODBC]" in error_message:
        logger.error(f"ODBC driver error: {error_message}")
        raise HTTPException(
            status_code=500, 
            detail="ODBC driver error - Vui lòng kiểm tra cài đặt driver ODBC"
        )
    logger.error(f"Database error: {error_message}")
    raise HTTPException(status_code=500, detail="Lỗi kết nối cơ sở dữ liệu")
except Exception as e:
    logger.error(f"Unexpected error: {str(e)}")
    raise HTTPException(status_code=500, detail="Lỗi hệ thống")
```

## 📊 Logging Setup
```python
# backend/app/core/logger.py
import logging
import os
import sys
from datetime import datetime

def setup_logger(name):
    """Setup logger with file and console handlers"""
    logger = logging.getLogger(name)
    logger.setLevel(logging.DEBUG)
    
    # Create logs directory if it doesn't exist
    logs_dir = os.path.join("logs")
    os.makedirs(logs_dir, exist_ok=True)
    
    # Create file handler
    log_file = os.path.join(logs_dir, f"{datetime.now().strftime('%Y-%m-%d')}.log")
    file_handler = logging.FileHandler(log_file)
    file_handler.setLevel(logging.DEBUG)
    
    # Create console handler
    console_handler = logging.StreamHandler(sys.stdout)
    console_handler.setLevel(logging.DEBUG)
    
    # Create formatter
    formatter = logging.Formatter(
        '%(asctime)s - %(name)s - %(levelname)s - %(message)s'
    )
    file_handler.setFormatter(formatter)
    console_handler.setFormatter(formatter)
    
    # Add handlers to logger
    logger.addHandler(file_handler)
    logger.addHandler(console_handler)
    
    return logger
```

