### Health Check Component
```tsx
import React, { useEffect, useState } from 'react';
import { Alert, Spin, Space, Typography, Button } from 'antd';
import axios from 'axios';

const { Text, Title } = Typography;

interface HealthStatus {
  status: 'healthy' | 'warning' | 'error';
  message: string;
  details?: {
    database?: string;
    api?: string;
    odbc_driver?: string;
  };
}

export const HealthCheck: React.FC = () => {
  const [health, setHealth] = useState<HealthStatus | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const checkHealth = async () => {
    setLoading(true);
    setError(null);
    
    try {
      const response = await axios.get(`${import.meta.env.VITE_API_URL}/health`);
      setHealth(response.data);
    } catch (err) {
      if (axios.isAxiosError(err)) {
        if (err.code === 'ECONNREFUSED' || err.code === 'ERR_NETWORK') {
          setHealth({
            status: 'error',
            message: 'Không thể kết nối đến API server.',
            details: {
              api: 'API server không hoạt động hoặc không thể truy cập.'
            }
          });
        } else {
          setError(`Lỗi khi kiểm tra health: ${err.message}`);
        }
      } else {
        setError(`Lỗi không xác định: ${String(err)}`);
      }
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    checkHealth();
  }, []);

  if (loading) {
    return (
      <div style={{ textAlign: 'center', padding: '20px' }}>
        <Spin tip="Đang kiểm tra trạng thái hệ thống..." />
      </div>
    );
  }

  const getAlertType = (status: string) => {
    switch (status) {
      case 'healthy': return 'success';
      case 'warning': return 'warning';
      case 'error': return 'error';
      default: return 'info';
    }
  };

  const renderDriverSolution = () => {
    const message = health?.details?.odbc_driver;
    if (message && message.includes('not installed')) {
      return (
        <div style={{ marginTop: '16px' }}>
          <Title level={5}>Giải pháp cài đặt ODBC Driver:</Title>
          <ul>
            <li>
              <Text>macOS: <code>brew install microsoft/mssql-release/msodbcsql18</code></Text>
            </li>
            <li>
              <Text>Linux: Tham khảo <a href="https://learn.microsoft.com/en-us/sql/connect/odbc/linux-mac/installing-the-microsoft-odbc-driver-for-sql-server" target="_blank">hướng dẫn Microsoft</a></Text>
            </li>
          </ul>
        </div>
      );
    }
    return null;
  };

  return (
    <Space direction="vertical" style={{ width: '100%' }}>
      {error ? (
        <Alert
          type="error"
          message="Lỗi Kiểm Tra"
          description={error}
          showIcon
        />
      ) : health ? (
        <>
          <Alert
            type={getAlertType(health.status) as any}
            message={`Trạng thái Hệ thống: ${health.status === 'healthy' ? 'Khỏe mạnh' : health.status === 'warning' ? 'Cảnh báo' : 'Lỗi'}`}
            description={health.message}
            showIcon
          />
          
          {health.details && (
            <div style={{ marginTop: '16px' }}>
              <Title level={5}>Chi tiết:</Title>
              <ul>
                {health.details.database && (
                  <li>
                    <Text>Database: {health.details.database}</Text>
                  </li>
                )}
                {health.details.api && (
                  <li>
                    <Text>API: {health.details.api}</Text>
                  </li>
                )}
                {health.details.odbc_driver && (
                  <li>
                    <Text>ODBC Driver: {health.details.odbc_driver}</Text>
                  </li>
                )}
              </ul>
              
              {renderDriverSolution()}
            </div>
          )}
        </>
      ) : (
        <Alert
          type="warning"
          message="Không có dữ liệu"
          description="Không thể lấy thông tin trạng thái."
          showIcon
        />
      )}
      
      <Button type="primary" onClick={checkHealth} loading={loading}>
        Kiểm tra lại
      </Button>
    </Space>
  );
};
```

### Component with Ant Design + React Query
```tsx
import React from 'react';
import { Table, Button, message } from 'antd';
import { useQuery } from '@tanstack/react-query';
import { getSinhVienByLop } from '../../services/sinhVienService';

interface SinhVienTableProps {
  maLop: string;
  onEdit?: (maSV: string) => void;
}

export const SinhVienTable: React.FC<SinhVienTableProps> = ({ maLop, onEdit }) => {
  const { data, isLoading, error } = useQuery(
    ['sinhVien', maLop],
    () => getSinhVienByLop(maLop),
    { enabled: !!maLop }
  );

  if (error) {
    message.error('Không thể tải dữ liệu sinh viên');
    console.error('Error loading students:', error);
  }

  const columns = [
    { title: 'Mã SV', dataIndex: 'maSV', key: 'maSV' },
    { title: 'Họ', dataIndex: 'ho', key: 'ho' },
    { title: 'Tên', dataIndex: 'ten', key: 'ten' },
    {
      title: 'Thao tác',
      key: 'actions',
      render: (_, record) => (
        <Button onClick={() => onEdit?.(record.maSV)}>Sửa</Button>
      )
    }
  ];

  return <Table loading={isLoading} dataSource={data} columns={columns} rowKey="maSV" />;
};
```

### API Service with Error Handling
```typescript
import axios, { AxiosError } from 'axios';
import { SinhVien } from '../types/sinhVien';

const api = axios.create({
  baseURL: import.meta.env.VITE_API_BASE_URL,
  timeout: 10000,
});

// Add request interceptor for auth headers
api.interceptors.request.use((config) => {
  const token = localStorage.getItem('auth_token');
  if (token) {
    config.headers.Authorization = `Bearer ${token}`;
  }
  return config;
});

// Add response interceptor for error handling
api.interceptors.response.use(
  (response) => response,
  (error: AxiosError) => {
    if (error.response?.status === 401) {
      // Redirect to login or refresh token
      window.location.href = '/login';
    }
    return Promise.reject(error);
  }
);

export const getSinhVienByLop = async (maLop: string): Promise<SinhVien[]> => {
  try {
    const response = await api.get(`/sinhvien/lop/${maLop}`);
    return response.data;
  } catch (error) {
    const axiosError = error as AxiosError;
    console.error('API Error:', axiosError.response?.data);
    throw new Error(axiosError.response?.data?.detail || 'Lỗi khi tải dữ liệu');
  }
};

export const checkHealth = async () => {
  try {
    const response = await axios.get(`${import.meta.env.VITE_API_URL}/health`);
    return response.data;
  } catch (error) {
    console.error('Health check error:', error);
    throw error;
  }
};
```

### Custom Hook
```typescript
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { getSinhVienByLop, createSinhVien, checkHealth } from '../services/sinhVienService';

export const useSinhVienList = (maLop: string) => {
  return useQuery(['sinhVien', maLop], () => getSinhVienByLop(maLop), {
    enabled: !!maLop,
    staleTime: 5 * 60 * 1000, // 5 minutes
    onError: (error) => console.error('Error in useSinhVienList:', error)
  });
};

export const useCreateSinhVien = () => {
  const queryClient = useQueryClient();
  
  return useMutation(createSinhVien, {
    onSuccess: (_, variables) => {
      queryClient.invalidateQueries(['sinhVien', variables.maLop]);
    }
  });
};

export const useHealthCheck = () => {
  return useQuery(['health'], checkHealth, {
    refetchInterval: 30000, // Check every 30 seconds
    refetchOnWindowFocus: true,
    retry: 1
  });
};
```

### Protected Route Component
```tsx
import React from 'react';
import { Navigate } from 'react-router-dom';
import { useAuth } from '../contexts/AuthContext';

interface ProtectedRouteProps {
  element: React.ReactNode;
  requiredRoles?: string[];
}

export const ProtectedRoute: React.FC<ProtectedRouteProps> = ({ 
  element, 
  requiredRoles = [] 
}) => {
  const { user, loading } = useAuth();

  if (loading) return <div>Loading...</div>;
  if (!user) return <Navigate to="/login" replace />;
  if (requiredRoles.length > 0 && !requiredRoles.includes(user.role)) {
    return <Navigate to="/unauthorized" replace />;
  }

  return <>{element}</>;
};
```

## ❌ Anti-Patterns
```typescript
// ❌ Wrong: Hardcode API URL
const API_URL = "http://localhost:8000/api/v1";

// ✅ Right: Environment variables
const API_URL = import.meta.env.VITE_API_BASE_URL;

// ❌ Wrong: Class components
class MyComponent extends React.Component { }

// ✅ Right: Functional components
const MyComponent: React.FC = () => { };

// ❌ Wrong: No error handling
const { data } = useQuery(['users'], fetchUsers);

// ✅ Right: With error handling
const { data, error } = useQuery(['users'], fetchUsers, {
  onError: (error) => console.error('Error:', error)
});

// ❌ Wrong: Không kiểm tra health hoặc kết nối
fetch("/api/data")

// ✅ Right: Kiểm tra health và xử lý lỗi
import { useHealthCheck } from '../hooks/useHealthCheck';
const { data: health } = useHealthCheck();
```

