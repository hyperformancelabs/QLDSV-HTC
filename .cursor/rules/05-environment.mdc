VITE_API_BASE_URL="http://localhost:${BACKEND_PORT}/api/v1"
VITE_API_URL="http://localhost:${BACKEND_PORT}"
VITE_HMR_PORT=${FRONTEND_PORT}
VITE_APP_NAME="QLDSV-HTC"
