# =============================================
# Backend Service Configuration (Example)
# =============================================

# Inherit all global variables from project root `.env`
include=../.env

# ---------------------------------------------------------------------
# ⚙️ FastAPI Application Settings
# ---------------------------------------------------------------------
# These variables configure the FastAPI/UVicorn server.  All have sane
# defaults in code, but you can override them per-environment here.

APP_TITLE="QLDSV-HTC API"
APP_DESCRIPTION="Simple API for QLDSV-HTC"
APP_VERSION="1.0.0"

# Server host/port (overrides BACKEND_HOST/BACKEND_PORT if both provided)
APP_HOST=0.0.0.0
APP_PORT=8000

# Auto-reload source files in development
APP_RELOAD=true

# ---------------------------------------------------------------------
# 🔧 API Configuration
# ---------------------------------------------------------------------

API_PREFIX=/api/v1

# ---------------------------------------------------------------------
# 🐍 Uvicorn / FastAPI Flags
# ---------------------------------------------------------------------

# Enable verbose debug logs (true|false)
FASTAPI_DEBUG=true
# Enable live-reload (true|false).  If set, overrides APP_RELOAD.
FASTAPI_RELOAD=true

# ---------------------------------------------------------------------
# 📜 Logging
# ---------------------------------------------------------------------
# LOG_LEVEL is inherited from root .env but can be overridden here
# LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------
# 🔐 SQL Server SA Credentials for User Management
# ---------------------------------------------------------------------
# SA credentials are needed for SQL login operations (create/delete)
# These should match the values in root .env
SA_USERNAME=sa
SA_PASSWORD=P@ssw0rd!QLDSV

# ---------------------------------------------------------------------
# 🛠️ Additional backend-specific configuration keys can be added below
# ---------------------------------------------------------------------

# Application
DB_NAME=QLDSV_HTC
MSSQL_APP_USER=app_user
MSSQL_APP_PASSWORD=Password123

# PGV Role
MSSQL_PGV_USER=pgv_user
MSSQL_PGV_PASSWORD=Password123

# KHOA Role
MSSQL_KHOA_USER=khoa_user
MSSQL_KHOA_PASSWORD=Password123

# SV Role
MSSQL_SV_USER=sv_user
MSSQL_SV_PASSWORD=Password123

# Superadmin (for specific high-privilege SPs)
MSSQL_SUPERADMIN_USER=superadmin
MSSQL_SUPERADMIN_PASSWORD=SuperSecretPassword123

