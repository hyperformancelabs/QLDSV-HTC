# =============================================
# Backend Service Configuration Example
# =============================================
# Copy this file to .env and modify values as needed

# Inherit from parent (automatic)
include=../.env

# =============================================
# Backend-Specific Settings
# =============================================

# Container Configuration
CONTAINER_NAME=qldsv-backend
APP_NAME=QLDSV-HTC Backend API
APP_VERSION=1.0.0

# FastAPI Settings
FASTAPI_ENV=development
FASTAPI_DEBUG=true
FASTAPI_RELOAD=true

# Database Connection (computed from shared config)
# Uses variables from parent .env
DATABASE_URL=mssql+pyodbc://${MSSQL_APP_USER}:${MSSQL_APP_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?driver=${DB_DRIVER}&TrustServerCertificate=yes

# SQLAlchemy Settings
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=false

# Security Settings
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# CORS Settings
CORS_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# Cache Settings
CACHE_EXPIRE_SECONDS=300

# Email Settings (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@qldsv-htc.com 