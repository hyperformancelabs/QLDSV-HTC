# =============================================
# Frontend Service Configuration Example
# =============================================
# Copy this file to .env and modify values as needed

# Inherit from parent (automatic)
include=../.env

# =============================================
# Frontend-Specific Settings
# =============================================

# Container Configuration
CONTAINER_NAME=qldsv-frontend
VITE_APP_NAME=QLDSV-HTC Frontend
VITE_APP_VERSION=1.0.0

# API Endpoints (computed from shared config)
# Uses variables from parent .env
VITE_API_BASE_URL=${BACKEND_API_URL}/api/v1
VITE_WS_URL=ws://${BACKEND_HOST}:${BACKEND_PORT}/ws

# Development Server Settings
VITE_HMR_PORT=5174
VITE_PREVIEW_PORT=4173
VITE_HOST=0.0.0.0

# Build Settings
VITE_BUILD_TARGET=es2020
VITE_OUTDIR=dist
VITE_SOURCEMAP=true
VITE_MINIFY=true

# Asset Settings
VITE_ASSET_URL=/assets
VITE_PUBLIC_URL=/

# Environment Info
VITE_NODE_ENV=development
VITE_BUILD_TIME=auto-generated

# Feature Flags
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_PWA=false

# Analytics (optional)
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=

# Themes and UI
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true
VITE_PRIMARY_COLOR=#1890ff

# Cache Settings
VITE_CACHE_BUST=true
VITE_SW_CACHE_NAME=qldsv-htc-v1 